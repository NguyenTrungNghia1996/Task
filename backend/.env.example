APP_ENV=development
PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taskmgmt
DB_SSLMODE=disable

# Database Migration & Logs
AUTO_MIGRATE=false
DB_LOG_SQL=false

# Authentication
JWT_SECRET=super-secret-taskmgmt-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Object Storage (MinIO / S3)
S3_ENDPOINT=localhost:9000
S3_BUCKET=task-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

