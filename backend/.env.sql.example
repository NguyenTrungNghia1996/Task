# ==========================================================
# Cấu hình môi trường cho VPS chạy Cơ sở dữ liệu (PostgreSQL)
# Sao chép tệp này thành .env trên VPS database trước khi chạy docker compose
# ==========================================================

POSTGRES_DB=taskmgmt
POSTGRES_USER=task_admin
# Đặt mật khẩu mạnh ngẫu nhiên tối thiểu 16 ký tự
POSTGRES_PASSWORD=YourStrongDatabasePassword123!

# Cổng lắng nghe của PostgreSQL trên VPS (mặc định 5432)
POSTGRES_PORT=5432

# Giới hạn bộ nhớ và CPU (Tùy chọn)
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100

# Cấu hình sao lưu tự động (Backup Cron)
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

